#!/usr/bin/env python3
"""Polish the selected text (bind this to a global shortcut, e.g. Meta+Shift+P).

The pill belongs to the daemon; this only sends "polish" to its socket.
"""
import os
import socket
import subprocess
import sys

sock = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "polish.sock")
try:
    s = socket.socket(socket.AF_UNIX)
    s.connect(sock)
    s.sendall(b"polish\n")
    print(s.recv(256).decode())
except OSError:
    # No daemon means no pill; fall back to a desktop notification.
    subprocess.run(["notify-send", "-a", "Polish", "-i", "dialog-error",
                    "Polish is not running", "systemctl --user start polish"])
    sys.exit(1)
